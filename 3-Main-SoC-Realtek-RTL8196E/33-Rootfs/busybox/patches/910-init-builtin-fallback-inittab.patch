--- a/init/init.c
+++ b/init/init.c
@@ -130,6 +130,7 @@
 #include "libbb.h"
 #include "common_bufsiz.h"
 #include <syslog.h>
+#include "builtin_inittab.h"
 #ifdef __linux__
 # include <linux/vt.h>
 # include <sys/sysinfo.h>
@@ -673,9 +674,62 @@
 	char *token[4];
 	parser_t *parser = config_open2("/etc/inittab", fopen_for_read);
 
-	if (parser == NULL)
+if (parser == NULL)
 #endif
 	{
+#ifdef INITTAB_BUILTIN_FALLBACK
+	/* Build-time fallback table (builtin_inittab.h, generated by
+	 * build_busybox.sh from the rootfs skeleton inittab with the
+	 * respawn/askfirst entries filtered out).  Used when /etc/inittab
+	 * is unreadable at boot — e.g. rf-hold builds where it is a
+	 * symlink into /userdata that is not mounted yet.  Getty and
+	 * friends deliberately come only from the real table once init
+	 * re-reads it; nothing may spawn on ttyS0 in the meantime.
+	 * Requires INITTAB_BUILTIN_FALLBACK (EXTRA_CFLAGS) and the
+	 * generated header; see build_busybox.sh. */
+	static const struct {
+		uint8_t    type;
+		const char name[10];
+	} acts[] = {
+		{ SYSINIT,    "sysinit"    },
+		{ WAIT,       "wait"       },
+		{ ONCE,       "once"       },
+		{ RESPAWN,    "respawn"    },
+		{ ASKFIRST,   "askfirst"   },
+		{ CTRLALTDEL, "ctrlaltdel" },
+		{ SHUTDOWN,   "shutdown"   },
+		{ RESTART,    "restart"    },
+	};
+	const char *const *tab;
+
+	for (tab = builtin_inittab_lines; *tab; tab++) {
+		char *p     = xstrdup(*tab);
+		char *id    = p;
+		char *runlv = strchr(id, ':');
+		char *act   = runlv ? strchr(runlv + 1, ':') : NULL;
+		char *cmd   = act ? strchr(act + 1, ':') : NULL;
+		int action  = -1;
+		size_t i;
+
+		if (!cmd) {
+			free(p);
+			continue;
+		}
+		*runlv++ = '\0';
+		*act++   = '\0';
+		*cmd++   = '\0';
+		for (i = 0; i < ARRAY_SIZE(acts); i++) {
+			if (strcmp(acts[i].name, act) == 0) {
+				action = acts[i].type;
+				break;
+			}
+		}
+		if (action >= 0)
+			new_init_action(action, cmd, id);
+		free(p);
+	}
+	return;
+#else
 		/* No inittab file - set up some default behavior */
 		/* Sysinit */
 		new_init_action(SYSINIT, INIT_SCRIPT, "");
@@ -694,6 +748,7 @@
 		/* Restart init when a QUIT is received */
 		new_init_action(RESTART, "init", "");
 		return;
+#endif
 	}
 
 #if ENABLE_FEATURE_USE_INITTAB
